+    "/items/1004-levis-farmer": (302, "/catalog"),
+    "/catalog": (200, listing_page("Katalógus", "<h1>Katalógus</h1><p>Sok minden.</p>")),
+    "/items/1005-nike-cipo": (200, listing_page("Nike cipő", "<iframe src='/captcha/frame'></iframe>")),
