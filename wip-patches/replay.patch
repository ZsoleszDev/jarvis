+def success_phrase(signature: str) -> bool:
+    """Azt írja-e az oldal címsora, hogy sikerült (és nem azt, hogy nem)."""
+    return bool(SUCCESS_RE.search(signature)) and not FAILURE_RE.search(signature)
+
